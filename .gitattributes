# Auto detect text files and perform LF normalization
* text=auto

# Godot scripts and shaders prefer LF
*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf

# Windows batch files require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.glb binary
*.gltf binary
*.vrm binary
*.wav binary
*.ogg binary
*.mp3 binary
