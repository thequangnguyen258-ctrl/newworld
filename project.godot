; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tân Thế Giới"
config/description="3D Open-World Walkable Life Simulator & City Builder in a Blessed World"
run/main_scene="res://scenes/core/main_world.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.12, 0.15, 0.18, 1)

[autoload]

WorldManager="*res://scripts/core/world_manager.gd"
BuildingJobRegistry="*res://scripts/simulation/building_job_registry.gd"
LocalBridge="*res://scripts/network/local_bridge.gd"
TransitNetworkManager="*res://scripts/simulation/transit_network_manager.gd"
DatabaseManager="*res://scripts/simulation/database_manager.gd"
UnifiedTimelineServer="*res://addons/unified_timeline/unified_timeline_server.gd"
ResearchManager="*res://scripts/simulation/research_manager.gd"
LogisticsManager="*res://scripts/simulation/logistics_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
AudioSynthesizer="*res://scripts/core/audio_synthesizer.gd"
GUIDE="*res://addons/guide/guide.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/initial_position_type=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/Godot-MToon-Shader/plugin.cfg", "res://addons/blendot/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/guide/plugin.cfg", "res://addons/octahedral_impostor_lod/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/road-generator/plugin.cfg", "res://addons/sqlite_viewer/plugin.cfg", "res://addons/tau-plot/plugin.cfg", "res://addons/unified_timeline/plugin.cfg", "res://addons/vrm/plugin.cfg")

